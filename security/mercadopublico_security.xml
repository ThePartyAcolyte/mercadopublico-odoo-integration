<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Crear una categoría específica para Mercado Público -->
    <record id="module_category_mercadopublico" model="ir.module.category">
        <field name="name">Mercado Público</field>
        <field name="description">Gestión de licitaciones de Mercado Público</field>
        <field name="sequence">15</field>
    </record>
    
    <!-- Grupos de seguridad específicos para Mercado Público -->
    <record id="group_mercadopublico_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_mercadopublico"/>
    </record>
    
    <record id="group_mercadopublico_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="implied_ids" eval="[(4, ref('group_mercadopublico_user'))]"/>
        <field name="category_id" ref="module_category_mercadopublico"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    
    <!-- Regla de registro para licitaciones -->
    <record id="rule_mercadopublico_licitacion_all_companies" model="ir.rule">
        <field name="name">Licitaciones Mercado Público: todas las compañías</field>
        <field name="model_id" ref="model_mercadopublico_licitacion"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mercadopublico_user'))]"/>
    </record>
    
    <!-- Regla multi-compañía para Dashboard -->
    <record id="rule_mercadopublico_dashboard_company" model="ir.rule">
        <field name="name">Dashboard Mercado Público: solo responsables</field>
        <field name="model_id" ref="model_mercadopublico_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mercadopublico_manager'))]"/>
    </record>
</odoo>