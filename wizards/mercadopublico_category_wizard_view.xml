<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mercadopublico_category_wizard_view_form" model="ir.ui.view">
        <field name="name">mercadopublico.category.wizard.form</field>
        <field name="model">mercadopublico.category.wizard</field>
        <field name="arch" type="xml">
            <form string="Editar Categorías UNSPSC">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                
                <div class="alert alert-info" role="status">
                    Selecciona las categorías UNSPSC asociadas. Utiliza la barra de búsqueda o navega por el árbol.
                </div>
                
                <sheet>
                    <field name="mercadopublico_category_ids" widget="categoria_tree" placeholder="Escribe para buscar categorías..."/>
                </sheet>
                <footer>
                    <button name="action_save" string="Guardar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mercadopublico_category_wizard" model="ir.actions.act_window">
        <field name="name">Editar Categorías UNSPSC</field>
        <field name="res_model">mercadopublico.category.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
