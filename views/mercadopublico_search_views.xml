<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mercadopublico_busqueda_view_form" model="ir.ui.view">
        <field name="name">mercadopublico.busqueda.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Configuración de Búsqueda" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Configuración de Búsqueda y Filtros</h1>
                    </div>
                    
                    <notebook>
                        <page string="Criterios de Búsqueda" name="criterios">
                            <group>
                                <group string="Palabras Clave">
                                    <field name="mercadopublico_keyword_ids" widget="many2many_tags" options="{'no_create_edit': True}" nolabel="1" colspan="2"/>
                                    <div class="text-muted" colspan="2">
                                        Las palabras clave aumentan la relevancia de las licitaciones si se encuentran coincidencias difusas o semánticas.
                                    </div>
                                </group>
                                <group string="Categorías">
                                    <field name="mercadopublico_category_ids" widget="categoria_tree" nolabel="1" colspan="2"/>
                                    <div class="text-muted" colspan="2">
                                        Categorías UNSPSC de interés.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Ubicaciones" name="ubicaciones">
                            <group>
                                <field name="mercadopublico_location_ids" widget="ubicacion_tree" nolabel="1" colspan="2"/>
                                <div class="text-muted" colspan="2">
                                    Selecciona las Regiones o Comunas específicas para buscar. (El modo de filtrado se configura en Ajustes).
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
