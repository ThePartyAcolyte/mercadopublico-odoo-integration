<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agregar campos a la vista de formulario de oportunidades -->
    <record id="crm_lead_view_form_mercadopublico" model="ir.ui.view">
        <field name="name">crm.lead.form.mercadopublico</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar indicador visual en la parte superior -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div invisible="not is_mercadopublico" class="float-right mb-2">
                    <span class="badge badge-info p-2" style="font-size: 14px;">
                        <img src="/mercadopublico_odoo_integration/static/img/logo-chilecompra-original.png" width="136" height="30" class="mr-1" style="vertical-align: middle;" alt="Logo ChileCompra"/>
                 
                    </span>
                </div>
            </xpath>
            <!-- Agregar botón para ver licitación -->
            <div name="button_box" position="inside">
                <button name="action_view_mercadopublico_tender" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-gavel" 
                        string="Licitación"
                        invisible="not is_mercadopublico"/>
            </div>
            
            <!-- Agregar pestaña para información de licitación -->
            <notebook position="inside">
                <page string="Mercado Público" invisible="not is_mercadopublico">
                    <group>
                        <group>
                            <field name="is_mercadopublico" invisible="1"/>
                            <field name="mercadopublico_id" readonly="1"/>
                            <field name="mercadopublico_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="mercadopublico_closing_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    
    <!-- Agregar indicador a la vista de lista de oportunidades -->
    <record id="crm_lead_view_list_mercadopublico" model="ir.ui.view">
        <field name="name">crm.lead.list.mercadopublico</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_mercadopublico" invisible="1"/>
                <field name="mercadopublico_code" 
                       invisible="context.get('search_default_is_mercadopublico', False) != True" 
                       string="Código MP"/>
            </field>
        </field>
    </record>
    
    <!-- Agregar filtro para oportunidades de Mercado Público -->
    <record id="crm_lead_view_search_mercadopublico" model="ir.ui.view">
        <field name="name">crm.lead.search.mercadopublico</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="filter_won_status_lost" position="after">
                <separator/>
                <filter string="Mercado Público" name="is_mercadopublico" domain="[('is_mercadopublico', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>