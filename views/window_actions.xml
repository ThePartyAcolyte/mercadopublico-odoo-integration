<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACCIONES -->

    <!-- Acción para configuración de búsqueda unificada (usando res.company) -->
    <record id="action_mercadopublico_busqueda" model="ir.actions.server">
        <field name="name">Criterios de Búsqueda</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'name': 'Configuración de Búsqueda',
    'type': 'ir.actions.act_window',
    'res_model': 'res.company',
    'view_mode': 'form',
    'view_id': env.ref('MercadoPublico-Odoo.mercadopublico_busqueda_view_form').id,
    'res_id': env.company.id,
    'target': 'current',
}
        </field>
    </record>


    <record id="action_mercadopublico_licitacion" model="ir.actions.act_window">
        <field name="name">Licitaciones</field>
        <field name="res_model">mercadopublico.licitacion</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_apta': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay licitaciones importadas
            </p>
            <p>
                Las licitaciones serán importadas automáticamente mediante el proceso programado.
            </p>
        </field>
    </record>



    <!-- Acción para palabras clave (filtros) -->
    <record id="action_mercadopublico_filtro" model="ir.actions.act_window">
        <field name="name">Palabras Clave</field>
        <field name="res_model">mercadopublico.filtro</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primera palabra clave
            </p>
            <p>
                Las palabras clave le permiten filtrar licitaciones relevantes.
            </p>
        </field>
    </record>

    <!-- Acción para oportunidades de Mercado Público -->
    <record id="action_crm_lead_mercadopublico" model="ir.actions.act_window">
        <field name="name">Oportunidades de Mercado Público</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_is_mercadopublico': 1}</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>



    <!-- Acción para organismos -->
    <record id="action_mercadopublico_organismo" model="ir.actions.act_window">
        <field name="name">Organismos Públicos</field>
        <field name="res_model">mercadopublico.organismo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Acción para categorias -->
    <record id="action_mercadopublico_categoria" model="ir.actions.act_window">
        <field name="name">Categorías UNSPSC</field>
        <field name="res_model">mercadopublico.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Acción para etapas -->
    <record id="action_mercadopublico_etapa" model="ir.actions.act_window">
        <field name="name">Etapas Kanban</field>
        <field name="res_model">mercadopublico.etapa</field>
        <field name="view_mode">list,form</field>
    </record>




</odoo>