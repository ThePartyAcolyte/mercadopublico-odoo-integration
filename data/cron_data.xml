<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron para importar licitaciones diariamente -->
        <!-- Se ejecuta a las 23:00 para capturar todas las licitaciones publicadas en el día.
             Ajustar en Técnico > Automatización > Acciones Programadas si se prefiere otro horario.
             Con dias_busqueda_atras=0 se buscan licitaciones del día actual. -->
        <record id="ir_cron_mercadopublico_import_tenders" model="ir.cron">
            <field name="name">Mercado Público: Importar Licitaciones (v1 Nocturno)</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_tenders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0) + (timedelta(days=1) if datetime.now().hour >= 23 else timedelta(days=0))).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Cron para importar Compras Ágiles incrementalmente mediante ttl_cambio_ms -->
        <record id="ir_cron_mercadopublico_import_quick_buys" model="ir.cron">
            <field name="name">Mercado Público: Importar Compras Ágiles (v2 Incremental)</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_quick_buys()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">60</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">6</field>
        </record>

        <!-- Cron para analizar licitaciones nuevas -->
        <!-- Corre cada 2 minutos. Con lotes de 50 y ~0.6s por registro,
             procesa ~1.500 licitaciones/hora, garantizando cero acumulación de cola. -->
        <record id="ir_cron_mercadopublico_analyze_tenders" model="ir.cron">
            <field name="name">Mercado Público: Analizar Licitaciones Nuevas</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_analyze_tenders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Cron para limpieza automática según política de retención -->
        <record id="ir_cron_mercadopublico_auto_cleanup" model="ir.cron">
            <field name="name">Mercado Público: Limpieza Automática de DB</field>
            <field name="model_id" ref="model_mercadopublico_tender"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_cleanup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>

        <!-- Cron para actualizar estado de licitaciones en seguimiento -->
        <record id="ir_cron_mercadopublico_update_status" model="ir.cron">
            <field name="name">Mercado Público: Actualizar Estado Licitaciones</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.update_tracked_tenders_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">15</field>
        </record>
    </data>
</odoo>