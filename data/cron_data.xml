<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron para importar licitaciones diariamente -->
        <!-- Se ejecuta a las 23:00 para capturar todas las licitaciones publicadas en el día.
             Ajustar en Técnico > Automatización > Acciones Programadas si se prefiere otro horario.
             Con dias_busqueda_atras=0 se buscan licitaciones del día actual. -->
        <record id="ir_cron_mercadopublico_importar_licitaciones" model="ir.cron">
            <field name="name">Mercado Público: Importar Licitaciones</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_importar_licitaciones()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0) + (timedelta(days=1) if datetime.now().hour >= 23 else timedelta(days=0))).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Cron para analizar licitaciones nuevas -->
        <!-- Corre cada 5 minutos. Con lotes de 20 y ~0.5s por licitación,
             procesa ~240 licitaciones/hora. Un día típico (~350 licitaciones) se analiza en ~90 min. -->
        <record id="ir_cron_mercadopublico_analizar_licitaciones" model="ir.cron">
            <field name="name">Mercado Público: Analizar Licitaciones Nuevas</field>
            <field name="model_id" ref="model_mercadopublico_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_analizar_licitaciones()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Cron para limpieza automática según política de retención -->
        <record id="ir_cron_mercadopublico_limpieza_automatica" model="ir.cron">
            <field name="name">Mercado Público: Limpieza Automática de DB</field>
            <field name="model_id" ref="model_mercadopublico_licitacion"/>
            <field name="state">code</field>
            <field name="code">model.cron_limpieza_automatica()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>
    </data>
</odoo>